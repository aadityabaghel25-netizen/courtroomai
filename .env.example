# Nebius Token Factory API key (from the Token Factory console)
TOKEN_FACTORY_API_KEY=
# Token Factory base URL your key works with, e.g. the OpenAI-compatible /v1 URL shown in your console
TOKEN_FACTORY_BASE_URL=
# Nemotron model IDs; leave blank and they will be chosen from the live model list
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=
# Tavily Search API key (good-law check and audit-mode lookup)
TAVILY_API_KEY=
# Indian Kanoon API token (only needed to re-run ingestion)
INDIANKANOON_API_TOKEN=
# Sarvam AI key, only for generating the demo video voiceover (not used by the app)
SARVAM_API_KEY=
